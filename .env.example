# Environment Configuration Template
# Copy this to .env and fill in your values

# Required: GitHub vault configuration
VAULT_OWNER=your-github-username
VAULT_REPO=your-vault-repo
GITHUB_TOKEN=ghp_your_token_here

# Required: MCP authentication
MCP_AUTH_SECRET=your-random-secret-token

# Optional: Vault settings
VAULT_BRANCH=main
VAULT_ROOT=
DAILY_NOTES_DIR=daily

# Optional: Limits
MAX_FILE_SIZE=1048576
MAX_SEARCH_RESULTS=50
MAX_GRAPH_NODES=100

# Optional: AI provider (for future features)
AI_PROVIDER=
AI_API_KEY=
