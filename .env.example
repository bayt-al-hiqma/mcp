# ChatGPT MCP supports OAuth or no auth. This implementation exposes the MCP endpoint with no auth.
# Optionally protect /api/diagnostics only with a bearer token.
DIAGNOSTICS_TOKEN=change-me

# Backend: github for Vercel deployments, local for development/tests
VAULT_BACKEND=github

# GitHub vault backend configuration
GITHUB_TOKEN=ghp_xxx
GITHUB_OWNER=your-user-or-org
GITHUB_REPO=your-markdown-vault
GITHUB_BRANCH=main
VAULT_ROOT=Memory

# Local development backend only
LOCAL_VAULT_DIR=./vault

# Memory defaults
DAILY_NOTES_DIR=Daily
CANONICAL_NOTES_DIR=Memories
DECISIONS_DIR=Decisions
SEARCH_RESULT_LIMIT=8
GRAPH_RESULT_LIMIT=20
MAX_FILE_SIZE_BYTES=262144

# Optional AI provider credentials for future advisory features; not required for core operation
OPENAI_API_KEY=
