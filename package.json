{
  "name": "bayt-al-hiqma",
  "version": "0.1.0",
  "description": "Personal Memory MCP Server - A durable memory layer for ChatGPT conversations",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "memory",
    "chatgpt",
    "markdown",
    "obsidian",
    "knowledge-vault"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "@octokit/rest": "^21.0.2",
    "gray-matter": "^4.0.3",
    "markdown-it": "^14.1.0",
    "micromatch": "^4.0.8"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/micromatch": "^4.0.9",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18.0.0"
  }
